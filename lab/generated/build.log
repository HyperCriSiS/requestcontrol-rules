
> prebuild
> npm run build-manual


> build-manual
> find ./_locales/ -iname "manual.wiki" -type f -exec sh -c 'pandoc "$0" --from=mediawiki --to=html --output "${0%.wiki}.html"' {} \;


> build
> web-ext build -i=$npm_package_config_ignore --overwrite-dest --verbose

